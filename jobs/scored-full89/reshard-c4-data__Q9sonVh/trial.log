    t = t.replace("thinking_level: medium", "thinking_level: xhigh")
    mt = os.environ.get("PENGUIN_MAX_TOKENS", "256000")
    cw = os.environ.get("PENGUIN_CONTEXT_WINDOW", "900000")
    t = t.replace("max_tokens: 32000", f"max_tokens: {mt}")
    t = t.replace("max_tokens: 128000", f"max_tokens: {mt}")
    t = t.replace("max_tokens: 256000", f"max_tokens: {mt}")
    t = t.replace("timeoutMs: 120000", "timeoutMs: 900000", 1)
    t = t.replace("max_context_length: 128000", f"max_context_length: {cw}")
    t = t.replace("max_context_length: 900000", f"max_context_length: {cw}")
    t = t.replace("skills:\n  enabled: true", "skills:\n  enabled: false")
    t = t.replace("memory:\n  enabled: true", "memory:\n  enabled: false")
    t = t.replace("vault:\n  enabled: true", "vault:\n  enabled: false")
    t = t.replace("schedules:\n  enabled: true", "schedules:\n  enabled: false")
    p.write_text(t)
    print("patched", p)

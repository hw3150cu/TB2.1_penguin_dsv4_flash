msg = pathlib.Path("/tmp/penguin-instruction.txt").read_text()
cmd = [
    "penguin", "run", "--approve", "allow-all",
    "--provider", os.environ["PENGUIN_PROVIDER"],
    "--model-id", os.environ["PENGUIN_MODEL_ID"],
    "--workspace", os.environ["PENGUIN_WS"],
    "--message", msg,
]
raise SystemExit(subprocess.call(cmd))
PY
rc=${PIPESTATUS[0]}
set -e
mkdir -p /logs/agent/penguin-traces
find /logs/agent/penguin-home -name '*.jsonl' -exec cp -n {} /logs/agent/penguin-traces/ \; 2>/dev/null || true
exit $rc


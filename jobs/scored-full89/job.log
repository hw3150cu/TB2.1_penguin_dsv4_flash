Running command: set -euo pipefail
export PATH="/tmp/penguin/bin:$HOME/.local/bin:$PATH"
export PENGUIN_HOME="/logs/agent/penguin-home"
export PENGUIN_UPDATE_CHECK=off
export PENGUIN_WS="${PWD:-$(pwd)}"
mkdir -p /logs/agent/penguin-home /logs/agent
umask 077
printf '%s' "$HARBOR_INSTRUCTION" > /tmp/penguin-instruction.txt
set +e
python3 - <<'PY' 2>&1 | stdbuf -oL tee /logs/agent/penguin.txt
import os, pathlib, subprocess, sys
msg = pathlib.Path("/tmp/penguin-instruction.txt").read_text()
cmd = [
    "penguin", "run", "--approve", "allow-all",
    "--provider", os.environ["PENGUIN_PROVIDER"],
    "--model-id", os.environ["PENGUIN_MODEL_ID"],
    "--workspace", os.environ["PENGUIN_WS"],
    "--message", msg,
]
raise SystemExit(subprocess.call(cmd))
PY
rc=${PIPESTATUS[0]}
set -e
mkdir -p /logs/agent/penguin-traces
find /logs/agent/penguin-home -name '*.jsonl' -exec cp -n {} /logs/agent/penguin-traces/ \; 2>/dev/null || true
exit $rc


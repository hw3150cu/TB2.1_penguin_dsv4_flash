export PATH="/tmp/penguin/bin:$HOME/.local/bin:$PATH"
export PENGUIN_HOME="/logs/agent/penguin-home"
export PENGUIN_UPDATE_CHECK=off
mkdir -p "$PENGUIN_HOME"
penguin config model add \
  --provider custom \
  --model-id "$PENGUIN_MODEL_ID" \
  --api-key "$DEEPSEEK_API_KEY" \
  --base-url "$DEEPSEEK_BASE_URL" --client-type openai --context-window "${PENGUIN_CONTEXT_WINDOW:-1048576}"  \
  --max-tokens "${PENGUIN_MAX_TOKENS:-256000}" \
  --no-vision \
  --set-default
AGENT_DIR="$PENGUIN_HOME/default_project/agents/default_agent/agent_state"
mkdir -p "$AGENT_DIR" "$PENGUIN_HOME/default_project/agents/default_agent/traces" \
  "$PENGUIN_HOME/default_project/agents/default_agent/scratchpad"
if [ -f /tmp/penguin-pkg/system_config.yaml ]; then
  cp /tmp/penguin-pkg/system_config.yaml "$AGENT_DIR/system_config.yaml"
fi
if [ -f /tmp/penguin-pkg/AGENTS.md ]; then
  cp /tmp/penguin-pkg/AGENTS.md "$AGENT_DIR/AGENTS.md"
fi
python3 - <<'PY'
from pathlib import Path
import os
root = Path(os.environ["PENGUIN_HOME"])
for p in root.rglob("system_config.yaml"):
    t = p.read_text()
    t = t.replace("thinking_level: medium", "thinking_level: xhigh")
    mt = os.environ.get("PENGUIN_MAX_TOKENS", "256000")
    cw = os.environ.get("PENGUIN_CONTEXT_WINDOW", "900000")
    t = t.replace("max_tokens: 32000", f"max_tokens: {mt}")
    t = t.replace("max_tokens: 128000", f"max_tokens: {mt}")
    t = t.replace("max_tokens: 256000", f"max_tokens: {mt}")
    t = t.replace("timeoutMs: 120000", "timeoutMs: 900000", 1)
    t = t.replace("max_context_length: 128000", f"max_context_length: {cw}")
    t = t.replace("max_context_length: 900000", f"max_context_length: {cw}")
    t = t.replace("skills:\n  enabled: true", "skills:\n  enabled: false")
    t = t.replace("memory:\n  enabled: true", "memory:\n  enabled: false")
    t = t.replace("vault:\n  enabled: true", "vault:\n  enabled: false")
    t = t.replace("schedules:\n  enabled: true", "schedules:\n  enabled: false")
    p.write_text(t)
    print("patched", p)
PY


text(src)\n   143\t        if is_invoice(text):\n   144\t            total, vat = extract_invoice_values(text)\n   145\t            invoices.append({\"filename\": fname, \"total_amount\": total, \"vat_amount\": vat})\n   146\t            print(f\"[invoice] {fname}: total={fmt_num(total)} vat={fmt_num(vat)}\")\n   147\t        else:\n   148\t            print(f\"[other]   {fname}\")\n   149\t\n   150\t    # Move files\n   151\t    invoice_names = {inv[\"filename\"] for inv in invoices}\n   152\t    for fname in files:\n   153\t        src = os.path.join(DOC_DIR, fname)\n   154\t        dest = INV_DIR if fname in invoice_names else OTH_DIR\n   155\t        shutil.move(src, os.path.join(dest, fname))\n   156\t\n   157\t    # Write summary.csv\n   158\t    total_sum = sum(r[\"total_amount\"] for r in invoices)\n   159\t    vat_sum = sum(r[\"vat_amount\"] for r in invoices)\n   160\t    with open(CSV_PATH, \"w\", newline=\"\") as fh:\n   161\t        writer = csv.writer(fh)\n   162\t        writer.writerow([\"filename\", \"total_amount\", \"vat_amount\"])\n   163\t        for r in invoices:\n   164\t            writer.writerow([r[\"filename\"], fmt_num(r[\"total_amount\"]), fmt_num(r[\"vat_amount\"])])\n   165\t        writer.writerow([\"total\", fmt_num(total_sum), fmt_num(vat_sum)])\n   166\t\n   167\t    print(\"\\nCSV written to\", CSV_PATH)\n   168\t\n   169\t\n   170\tif __name__ == \"__main__\":\n   171\t    main()","tool_call_id":"chatcmpl-tool-a41e7e626d3d6818","stop_reason":"completed"}}

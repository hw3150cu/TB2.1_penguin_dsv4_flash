    amounts = dollar_amounts(text)\\n    # Also capture amounts that appear after \\\"Total $\\\" even without leading spaces,\\n    # e.g. \\\"Total $5 640,17 $ 564,02 $ 6 204,19\\\".\\n    mtot = re.findall(r\\\"Total\\\\s+\\\\$?\\\\s*([\\\\d][\\\\d\\\\s.,]*)\\\", text)\\n    for raw in mtot:\\n        tokens = re.findall(r\\\"\\\\$?\\\\s*([\\\\d][\\\\d\\\\s.,]*)\\\", raw)\\n        for tok in tokens:\\n            try:\\n                amounts.append(parse_number(tok))\\n            except ValueError:\\n                continue\\n    if len(amounts) >= 2:\\n        total = amounts[-1]        # gross worth (total incl. tax)\\n        vat = amounts[-2]          # vat amount\\n        return total, vat\\n    raise ValueError(\\\"could not find total/VAT amounts\\\")\\n\\n\\ndef fmt_num(x: float) -> str:\\n    \\\"\\\"\\\"Format to a clean decimal: integers without trailing .0.\\\"\\\"\\\"\\n    if abs(x - round(x)) < 1e-9:\\n        return str(int(round(x)))\\n    s = format(x, \\\".20f\\\").rstrip(\\\"0\\\").rstrip(\\\".\\\")\\n    if s.endswith(\\\".\\\"):\\n        s = s[:-1]\\n    return s\\n\\n\\ndef main():\\n    os.makedirs(INV_DIR, exist_ok=True)\\n    os.makedirs(OTH_DIR, exist_ok=True)\\n\\n    files = sorted(\\n        f\\n        for f in os.listdir(DOC_DIR)\\n        if os.path.splitext(f)[1].lower() in INVOICE_EXTENSIONS\\n    )\\n\\n    invoices = []\\n    for fname in files:\\n        src = os.path.join(DOC_DIR, fname)\\n        text = extract_text(src)\\n        if is_invoice(text):\\n            total, vat = extract_invoice_values(text)\\n            invoices.append({\\\"filename\\\": fname, \\\"total_amount\\\": total, \\\"vat_amount\\\": vat})\\n            print(f\\\"[invoice] {fname}: total={fmt_num(total)} vat={fmt_num(vat)}\\\")\\n        else:\\n            print(f\\\"[other]   {fname}\\\")\\n\\n    # Move files\\n    for fname in files:\\n        src = os.path.join(DOC_DIR, fname)\\n        dest = INV_DIR if os.path.join(DOC_DIR, fname) is not None and any(\\n            inv[\\\"filename\\\"] == fname for inv in invoices\\n        ) else OTH_DIR\\n        shutil.move(src, os.path.join(dest, fname))\\n\\n    # Write summary.csv\\n    total_sum = sum(r[\\\"total_amount\\\"] for r in invoices)\\n    vat_sum = sum(r[\\\"vat_amount\\\"] for r in invoices)\\n    with open(CSV_PATH, \\\"w\\\", newline=\\\"\\\") as fh:\\n        writer = csv.writer(fh)\\n        writer.writerow([\\\"filename\\\", \\\"total_amount\\\", \\\"vat_amount\\\"])\\n        for r in invoices:\\n            writer.writerow([r[\\\"filename\\\"], fmt_num(r[\\\"total_amount\\\"]), fmt_num(r[\\\"vat_amount\\\"])])\\n        writer.writerow([\\\"total\\\", fmt_num(total_sum), fmt_num(vat_sum)])\\n\\n    print(\\\"\\\\nCSV written to\\\", CSV_PATH)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}","tool_call_id":"chatcmpl-tool-a83d9a7f09efa542","stop_reason":"completed"}}
